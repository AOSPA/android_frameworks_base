<resources>

    <!-- Color of the UDFPS pressed view -->
    <color name="config_udfpsColor">#ffffffff</color>

    <!-- Whether to enable framework dimming for UDFPS -->
    <bool name="config_udfpsFrameworkDimming">false</bool>

    <!-- Brightness-to-alpha lookup table (LUT) for UDFPS framework dimming.
         Each entry is in the format <brightness>,<alpha> where:
           - brightness = panel backlight level
           - alpha = dim layer transparency applied at that brightness
         Rules:
           • The entries should be strictly ascending by brightness.
           • First entry = <minBrightness,maxAlpha>.
           • Last entry  = <maxBrightness,minAlpha>.
    -->
    <string-array name="config_udfpsDimmingBrightnessAlphaArray" translatable="false">
          <item>3,238</item>
          <item>4,236</item>
          <item>6,236</item>
          <item>10,234</item>
          <item>20,228</item>
          <item>30,222</item>
          <item>45,217</item>
          <item>70,209</item>
          <item>100,200</item>
          <item>150,191</item>
          <item>227,178</item>
          <item>300,167</item>
          <item>400,154</item>
          <item>500,143</item>
          <item>600,133</item>
          <item>800,117</item>
          <item>1023,109</item>
          <item>1130,95</item>
          <item>1211,89</item>
          <item>1394,79</item>
          <item>1598,69</item>
          <item>1817,53</item>
          <item>2047,46</item>
          <item>4095,0</item>
    </string-array>

    <!-- Whether usage of the proximity sensor during doze is supported -->
    <bool name="doze_proximity_sensor_supported">true</bool>

    <!-- Doze: does the double tap sensor need a proximity check? -->
    <bool name="doze_double_tap_proximity_check">false</bool>

    <!-- Doze: does the long press sensor need a proximity check? -->
    <bool name="doze_long_press_proximity_check">false</bool>

    <!-- Doze: does the single tap sensor need a proximity check? -->
    <bool name="doze_single_tap_proximity_check">false</bool>

    <!-- Doze: does the pickup sensor need a proximity check? -->
    <bool name="doze_pickup_event_proximity_check">false</bool>

    <!-- Whether to briefly keep the display in ON state when transitioning from
         DOZE_AOD_PAUSED to DOZE_AOD state. -->
    <bool name="config_displayTurnsOnWhenResumingAod">false</bool>

</resources>
